# Copy to .env (run.sh loads it). Every line is optional.

# Speech-to-text model for voice notes. Empty = demo mode (a sample transcript is returned).
# Needs: pip install faster-whisper. Example values: tiny, base, small
YOLO_WHISPER_MODEL=
YOLO_LANG=id

# Where shared records are kept. Must be a folder the server can write to and that survives restarts.
# YOLO_STORE=/var/data/yolowisata-store.json

# Which website addresses may call this server. * = any. Example: https://yolowisata.vercel.app
YOLO_ORIGINS=*
